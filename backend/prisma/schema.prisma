generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  username  String?   @unique
  createdAt DateTime @default(now())

  submissions Submission[]
  solved      SolvedProblem[]
}

model Question {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  difficulty  String     @default("Easy")
  topic       String     @default("General")
  starterCode String?

  testCases   TestCase[]
  examples    Example[]

  submissions Submission[]
  solvedBy    SolvedProblem[]

  createdAt   DateTime   @default(now())
}

model TestCase {
  id         Int      @id @default(autoincrement())
  input      String
  expected   String
  isHidden   Boolean  @default(true)
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Example {
  id          Int      @id @default(autoincrement())
  questionId  Int
  input       String
  output      String
  explanation String?
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Submission {
  id          Int      @id @default(autoincrement())
  userId      Int
  questionId  Int
  code        String
  language    String
  status      String
  runtime     Float?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model SolvedProblem {
  id         Int      @id @default(autoincrement())
  userId     Int
  questionId Int
  solvedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}